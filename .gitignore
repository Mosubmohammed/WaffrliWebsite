# .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Environment variables
.env
.env.*
!.env.example

# Virtual environment
venv/
env/
ENV/
.venv/
.env/

# Media files (user uploads)
media/
media/*
!media/.gitkeep

# Static files (after collectstatic)
static/
static/*
!static/.gitkeep

# IDE specific files
# VSCode
.vscode/
.history/

# PyCharm
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Testing
.coverage
.pytest_cache/
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Backup files
*.bak
*.backup
*~

# Temporary files
*.tmp
*.temp
temp/
tmp/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database backups
*.sql
*.dump

# Compiled files
*.pyc

# Local configuration
local_settings.py
settings_local.py

# Security and sensitive data
secrets.json
.secrets/
credentials.json

# Documentation builds
docs/_build/
docs/site/

# Misc
.cache
.mypy_cache/
.dmypy.json
dmypy.json

# Celery
celerybeat-schedule
celerybeat.pid

# Sphinx documentation
docs/_build/

# Jupyter Notebook
.ipynb_checkpoints

# Node modules (if using frontend tools)
node_modules/
npm-debug.log
yarn-error.log

# Sass
.sass-cache/
*.css.map

# Webpack
webpack-stats.json

# Parcel
.parcel-cache/

# Next.js
.next/

# Nuxt.js
.nuxt/
dist/

# Sentry
.sentryclirc

# Local data files (if any)
*.csv
*.xlsx
*.xls

# Ignore specific directories in your project
# (uncomment and modify as needed)
# /your_app/migrations/*.pyc
# /your_app/migrations/__pycache__/

# Keep empty directories with .gitkeep files
!.gitkeep